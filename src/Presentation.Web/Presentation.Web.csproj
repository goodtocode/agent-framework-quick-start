<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>Goodtocode.AgentStart.Presentation.Web</RootNamespace>
		<AssemblyName>Goodtocode.AgentStart.Presentation.Web</AssemblyName>
		<Version>1.0.0</Version>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>7648e281-79e9-4021-a119-a68a91e3356a</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="wwwroot\css\**" />
	  <Content Remove="wwwroot\css\**" />
	  <EmbeddedResource Remove="wwwroot\css\**" />
	  <None Remove="wwwroot\css\**" />
	</ItemGroup>

  <ItemGroup>
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
		<PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
		<PackageReference Include="Goodtocode.SecuredHttpClient" Version="1.1.11" />
		<PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.2.0" />
		<PackageReference Include="Markdig" Version="1.6.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.1.0" />		
		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Emoji" Version="5.1.0" />		
		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.1.0" />
		<PackageReference Include="Microsoft.Identity.Web" Version="4.18.0" />
		<PackageReference Include="Microsoft.Identity.Web.DownstreamApi" Version="4.18.0" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
		<!-- Remove when Microsoft.Identity.Web resolves Pkcs >= 10.0.13 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
	</ItemGroup>
</Project>
