<FluentText Size="TextSize.Size300" Weight="TextWeight.Regular" Class="@Class" Style="@Style">
    @ChildContent
</FluentText>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; } = "p-label";
    [Parameter] public string? Style { get; set; } = string.Empty;
}