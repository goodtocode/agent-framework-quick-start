<FluentText Size="TextSize.Size600" Weight="TextWeight.Semibold" Class="@Class" Style="@Style">
    @ChildContent
</FluentText>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; } = "h3-label";
    [Parameter] public string? Style { get; set; } = string.Empty;
}