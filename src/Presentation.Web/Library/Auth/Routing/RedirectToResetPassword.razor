@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<Goodtocode.AgentFramework.Presentation.Web.Options.EntraExternalIdWebOptions> EntraExternalIdOptions

<H3Label>Redirecting to password reset...</H3Label>

@code {
    protected override void OnInitialized()
    {
        var passwordResetUrl = EntraExternalIdOptions.Value.PasswordResetUrl;
        if (string.IsNullOrWhiteSpace(passwordResetUrl))
        {
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        Navigation.NavigateTo(passwordResetUrl, forceLoad: true);
    }
}
