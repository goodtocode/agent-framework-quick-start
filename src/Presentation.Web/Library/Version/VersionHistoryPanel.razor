<FluentCard>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        <H3Label>Version History</H3Label>

        @if (!Items.Any())
        {
            <PLabel>No version history available.</PLabel>
        }
        else
        {
            @foreach (var item in Items.OrderByDescending(x => x.Version))
            {
                <FluentButton Appearance="@(item.Version == SelectedVersion ? ButtonAppearance.Outline : ButtonAppearance.Subtle)"
                              OnClick="@(() => OnSelectVersion.InvokeAsync(item.Version))">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        <FluentText>@($"v{item.Version} {item.Status}")</FluentText>
                        <FluentText>@(item.CreatedUtc?.ToUniversalTime().ToString("u") ?? "-")</FluentText>
                    </FluentStack>
                </FluentButton>
            }
        }
    </FluentStack>
</FluentCard>

@code {
    [Parameter] public IReadOnlyList<VersionHistoryItem> Items { get; set; } = [];
    [Parameter] public int? SelectedVersion { get; set; }
    [Parameter] public EventCallback<int> OnSelectVersion { get; set; }
}
