@page "/privacy"
@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]

<PageTitle>Privacy Policy | GoodToCode</PageTitle>

<HeadContent>
    <meta name="description" content="Privacy policy for this application." />
    <link rel="canonical" href="/privacy" />
    <meta property="og:title" content="Privacy Policy | GoodToCode" />
    <meta property="og:description" content="How this application handles data and analytics." />
    <meta property="og:url" content="/privacy" />
    <meta name="robots" content="index,follow" />
</HeadContent>

<main>
    <article>
        <header>
            <H1Label>Privacy Policy</H1Label>
            <PLabel>Last updated: @DateTime.UtcNow.ToString("yyyy-MM-dd")</PLabel>
        </header>

        <section>
            <H3Label>What we collect</H3Label>
            <p>We may collect usage, device, and interaction data needed to operate, secure, and improve this application experience.</p>
        </section>

        <section>
            <H3Label>How we use data</H3Label>
            <p>Data is used for application operation, performance monitoring, security, and product improvement.</p>
        </section>

        <section>
            <H3Label>Third-party analytics</H3Label>
            <p>When consent is granted, Microsoft Clarity may process interaction telemetry to help improve usability.</p>
            <p>See the <a href="/analytics-notice">Analytics Notice</a> for details.</p>
        </section>

        <section>
            <H3Label>Your choices</H3Label>
            <p>You can accept or decline analytics tracking in the consent notice. You can also clear browser storage to reset your choice.</p>
        </section>

        <footer>
            <p>This policy is baseline guidance and should be reviewed by legal counsel before production use.</p>
        </footer>
    </article>
</main>
