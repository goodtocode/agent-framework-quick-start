@page "/"
@using Goodtocode.AgentFramework.Presentation.Web.Library.Analytics
@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]

<PageTitle>Quick-start for Microsoft Agent Framework</PageTitle>

<FluentStack HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" VerticalGap="24">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Class="home-page-main">
        <FluentSpacer />

        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                <H1Label>Quick-start for Microsoft Agent Framework</H1Label>

                <PLabel>
                    Build and test AI-assisted chat workflows quickly with a focused, minimal starter experience.
                </PLabel>

                <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="6" HorizontalAlignment="HorizontalAlignment.Center">
                    <FluentBadge Content="Fast setup" />
                    <FluentBadge Content="Secure sign-in" />
                    <FluentBadge Content="Chat-first workflow" />
                </FluentStack>

                <FluentCard Class="home-page-steps-card">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                        <H3Label>Recommended first steps</H3Label>
                        <PLabel>1. Sign in to create your user context.</PLabel>
                        <PLabel>2. Open Chat Session to start a new conversation.</PLabel>
                        <PLabel>3. Ask a focused prompt and iterate from the response.</PLabel>
                    </FluentStack>
                </FluentCard>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6" HorizontalAlignment="HorizontalAlignment.Center">
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OpenChatSession">
                        Open Chat Session
                    </FluentButton>
                    <PLabel>
                        Tip: Start with a concrete task (for example, “Generate a summary and next actions”).
                    </PLabel>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    </FluentStack>
</FluentStack>
<FluentStack Orientation="Orientation.Vertical" VerticalGap="8" HorizontalAlignment="HorizontalAlignment.Center" Class="home-page-footer-links">
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true" HorizontalAlignment="HorizontalAlignment.Center">
        <FluentLink Href="/privacy">Privacy Policy</FluentLink>
        <FluentLink Href="/terms">Terms of Use</FluentLink>
        <FluentLink Href="/analytics-notice">Analytics Notice</FluentLink>
    </FluentStack>
</FluentStack>
<AnalyticsConsentBanner />

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void OpenChatSession()
    {
        Navigation.NavigateTo("/chat");
    }
}
