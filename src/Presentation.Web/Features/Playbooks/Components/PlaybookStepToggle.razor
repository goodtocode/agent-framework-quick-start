@using Goodtocode.AgentFramework.Presentation.Web.Features.Playbooks.Models

<div class="step-toggle" role="tablist" aria-label="Playbook CER step">
    @foreach (var step in Steps)
    {
        var isSelected = step == SelectedStep;
        <div class="step-toggle-tab @(isSelected ? "step-toggle-tab-selected" : null)"
             role="tab"
             aria-selected="@(isSelected ? "true" : "false")">
            <FluentButton Appearance="ButtonAppearance.Transparent" OnClick="@(() => SelectAsync(step))">
                @if (isSelected)
                {
                    <strong>@step</strong>
                }
                else
                {
                    @step
                }
            </FluentButton>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The currently selected CER step. Supports two-way binding (<c>@@bind-SelectedStep</c>) so
    /// the hosting page's step detail panel stays in sync without any route navigation.
    /// </summary>
    [Parameter] public PlaybookCerStep SelectedStep { get; set; } = PlaybookCerStep.Collect;
    [Parameter] public EventCallback<PlaybookCerStep> SelectedStepChanged { get; set; }

    // Rendered as a tab strip (flat buttons under an accent-colored underline indicator) rather
    // than filled/outlined buttons, so it reads as "select a view" rather than "run a command" -
    // distinguishing it at a glance from the repeatability controls' Rerun/Recall/Replay buttons,
    // which do execute a command.
    private static readonly PlaybookCerStep[] Steps =
    [
        PlaybookCerStep.Collect,
        PlaybookCerStep.Evaluate,
        PlaybookCerStep.Record
    ];

    private async Task SelectAsync(PlaybookCerStep step)
    {
        if (step == SelectedStep)
        {
            return;
        }

        SelectedStep = step;
        await SelectedStepChanged.InvokeAsync(step);
    }
}
