@using Goodtocode.AgentFramework.Presentation.Web.Features.Playbooks.Models

<FluentCard>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        @switch (Step)
        {
            case PlaybookCerStep.Collect:
                <H2Label>Collect</H2Label>
                <H3Label>Input</H3Label>
                <PLabel>@Result.CollectInput</PLabel>

                <H3Label>Processing / Action</H3Label>
                <PLabel>@GetProcessingDescription(PlaybookCerStep.Collect, "Gather evidence from the submitted input using deterministic queries or tool calls.")</PLabel>
                @if (GetActionDefinition(PlaybookCerStep.Collect) is { } collectAction)
                {
                    <FluentTextArea Rows="6" ReadOnly="true" Style="width:100%; font-family: monospace;" Value="@collectAction" />
                }

                <H3Label>Output</H3Label>
                @foreach (var item in GetDisplayItems(Result.CollectSummary))
                {
                    <PLabel>• @item</PLabel>
                }
                break;
            case PlaybookCerStep.Evaluate:
                <H2Label>Evaluate</H2Label>
                <H3Label>Input</H3Label>
                @foreach (var item in GetDisplayItems(Result.CollectSummary))
                {
                    <PLabel>• @item</PLabel>
                }

                <H3Label>Processing / Action</H3Label>
                <PLabel>@GetProcessingDescription(PlaybookCerStep.Evaluate, "Apply a classification or scoring rubric to the collected evidence.")</PLabel>
                @if (GetActionDefinition(PlaybookCerStep.Evaluate) is { } evaluateAction)
                {
                    <FluentTextArea Rows="6" ReadOnly="true" Style="width:100%; font-family: monospace;" Value="@evaluateAction" />
                }

                <H3Label>Output</H3Label>
                @foreach (var item in GetDisplayItems(Result.EvaluateSummary))
                {
                    <PLabel>• @item</PLabel>
                }
                break;
            case PlaybookCerStep.Record:
                <H2Label>Record</H2Label>
                <H3Label>Input</H3Label>
                @foreach (var item in GetDisplayItems(Result.EvaluateSummary))
                {
                    <PLabel>• @item</PLabel>
                }

                <H3Label>Processing / Action</H3Label>
                <PLabel>@GetProcessingDescription(PlaybookCerStep.Record, "Materialize the evaluated finding into a durable, human-readable outcome.")</PLabel>
                @if (GetActionDefinition(PlaybookCerStep.Record) is { } recordAction)
                {
                    <FluentTextArea Rows="6" ReadOnly="true" Style="width:100%; font-family: monospace;" Value="@recordAction" />
                }

                <H3Label>Output</H3Label>
                @foreach (var item in GetDisplayItems(Result.RecordSummary))
                {
                    <PLabel>• @item</PLabel>
                }
                break;
        }
    </FluentStack>
</FluentCard>

@code {
    /// <summary>
    /// The completed playbook execution whose Collect/Evaluate/Record detail is rendered.
    /// </summary>
    [Parameter, EditorRequired] public PlaybookExecutionResultModel Result { get; set; } = null!;

    /// <summary>
    /// Which CER step's detail to show, driven by <see cref="PlaybookStepToggle"/>.
    /// </summary>
    [Parameter] public PlaybookCerStep Step { get; set; } = PlaybookCerStep.Collect;

    /// <summary>
    /// The persisted catalog definition for this Playbook, supplying each CER step's real
    /// Name/Description and processing/action text (query, rubric, or template). Optional: may
    /// still be loading, in which case a generic processing description is shown instead.
    /// </summary>
    [Parameter] public PlaybookCatalogModel? Catalog { get; set; }

    private string GetProcessingDescription(PlaybookCerStep step, string fallback) =>
        Catalog?.Steps.TryGetValue(step, out var catalogStep) == true && !string.IsNullOrWhiteSpace(catalogStep.Description)
            ? catalogStep.Description
            : fallback;

    private string? GetActionDefinition(PlaybookCerStep step) =>
        Catalog?.Steps.TryGetValue(step, out var catalogStep) == true && !string.IsNullOrWhiteSpace(catalogStep.ActionDefinition)
            ? catalogStep.ActionDefinition
            : null;

    private static readonly string[] StructuredSummaryKeys =
    [
        "Database",
        "SizeGb",
        "TableCount",
        "IndexCount",
        "Classification",
        "Reason",
        "SourceText",
        "ExtractedTerms",
        "Category",
        "Confidence",
        "Rationale",
        "OverallScore",
        "RubricVersion",
        "Criteria"
    ];

    private static IEnumerable<string> GetDisplayItems(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return ["(none)"];

        var structuredItems = TryGetStructuredItems(text);
        return structuredItems.Count > 0 ? structuredItems : [text];
    }

    private static List<string> TryGetStructuredItems(string text)
    {
        var matches = new List<(string Key, int Index, int ValueStart)>();

        foreach (var key in StructuredSummaryKeys)
        {
            var startToken = $"{key}: ";
            if (text.StartsWith(startToken, StringComparison.Ordinal))
            {
                matches.Add((key, 0, startToken.Length));
            }

            var searchToken = $", {key}: ";
            var fromIndex = 0;
            while (fromIndex < text.Length)
            {
                var index = text.IndexOf(searchToken, fromIndex, StringComparison.Ordinal);
                if (index < 0)
                    break;

                matches.Add((key, index + 2, index + searchToken.Length));
                fromIndex = index + searchToken.Length;
            }
        }

        if (matches.Count == 0)
            return [];

        var ordered = matches
            .OrderBy(m => m.Index)
            .ToList();

        var results = new List<string>(ordered.Count);
        for (var i = 0; i < ordered.Count; i++)
        {
            var current = ordered[i];
            var end = i == ordered.Count - 1
                ? text.Length
                : ordered[i + 1].Index;

            var value = text[current.ValueStart..end].Trim();
            results.Add($"{current.Key}: {value}");
        }

        return results;
    }
}
