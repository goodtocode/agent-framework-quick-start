@page "/playbooks/essay"

@using Goodtocode.AgentFramework.Presentation.Web.Features.Playbooks.Components
@using Goodtocode.AgentFramework.Presentation.Web.Features.Playbooks.Models
@using Goodtocode.AgentFramework.Presentation.Web.Features.Playbooks.Services
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject IPlaybookService PlaybookService

<PageTitle>Essay Playbook</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <H1Label>Essay Rubric Evaluation Playbook</H1Label>
    <PLabel>
        Hybrid example Playbook: Collect wraps the submitted essay text, the agentic Evaluate
        stage scores it against four weighted rubric criteria, and the deterministic Record stage
        bands the overall score into a letter grade. Enter an essay to run it end to end.
    </PLabel>

    <FluentCard>
        <PlaybookRunForm Label="Essay text"
                         Placeholder="Paste the essay to evaluate..."
                         ButtonLabel="Run Essay Playbook"
                         Multiline="true"
                         OnSubmit="RunAsync" />
    </FluentCard>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <FluentMessageBar Severity="Severity.Error">@errorMessage</FluentMessageBar>
    }

    @if (result is not null)
    {
        <PlaybookResultPanel Result="result" />
    }
</FluentStack>

@code {
    private PlaybookExecutionResultModel? result;
    private string? errorMessage;

    private async Task RunAsync(string essayText)
    {
        errorMessage = null;
        try
        {
            result = await PlaybookService.RunEssayAsync(essayText);
        }
        catch (Exception ex)
        {
            errorMessage = $"The Essay Playbook could not be run: {ex.Message}";
        }
    }
}
