@page "/playbooks/sql-statistics"

@using Goodtocode.AgentFramework.Presentation.Web.Features.Playbooks.Components
@using Goodtocode.AgentFramework.Presentation.Web.Features.Playbooks.Models
@using Goodtocode.AgentFramework.Presentation.Web.Features.Playbooks.Services
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject IPlaybookService PlaybookService

<PageTitle>SQL Statistics Playbook</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <H1Label>SQL Statistics Classification Playbook</H1Label>

    @if (catalog is not null)
    {
        <PlaybookOverviewCard Catalog="catalog" />
    }

    <FluentCard>
        <PlaybookRunForm Label="Database name"
                         Placeholder="e.g. AgentFramework"
                         ButtonLabel="Run SQL Statistics Playbook"
                         Multiline="false"
                         OnSubmit="RunAsync" />
    </FluentCard>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <FluentMessageBar Severity="Severity.Error">@errorMessage</FluentMessageBar>
    }

    @if (result is not null)
    {
        <PlaybookResultPanel Result="result" Catalog="catalog" />
    }
</FluentStack>

@code {
    private const string PlaybookKey = "sql-statistics";

    private PlaybookCatalogModel? catalog;
    private PlaybookExecutionResultModel? result;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Loads the Playbook's "what it is" catalog info and "what happened last time" execution
        // summary up front, so both are visible immediately without requiring a fresh run.
        catalog = await PlaybookService.GetCatalogAsync(PlaybookKey);
        result = await PlaybookService.GetLatestExecutionAsync(PlaybookKey);
    }

    private async Task RunAsync(string databaseName)
    {
        errorMessage = null;
        try
        {
            result = await PlaybookService.RunSqlStatisticsAsync(databaseName);
        }
        catch (Exception ex)
        {
            errorMessage = $"The SQL Statistics Playbook could not be run: {ex.Message}";
        }
    }
}
