@if (Suggestions.Count > 0)
{
    <FluentStack Orientation="Orientation.Horizontal"
                 HorizontalAlignment="HorizontalAlignment.Center"
                 Wrap="true"
                 Class="suggested-prompts-strip">
        @foreach (var suggestion in Suggestions)
        {
            <FluentButton Appearance="ButtonAppearance.Outline"
                          OnClick="() => OnPromptClicked.InvokeAsync(suggestion)">
                @suggestion
            </FluentButton>
        }
    </FluentStack>
}

@code {
    [Parameter] public IReadOnlyList<string> Suggestions { get; set; } = [];
    [Parameter] public EventCallback<string> OnPromptClicked { get; set; }
}