@using System.Text.RegularExpressions
@using Goodtocode.AgentStart.Presentation.Web.Features.Chats.Formatting
@using Goodtocode.AgentStart.Presentation.Web.Features.Chats.Models
@using Microsoft.AspNetCore.Components

@inject IChatMessageFormatter ChatMessageFormatter

<div class="chat-message-list-host">
    <FluentStack Orientation="Orientation.Vertical"
                 VerticalAlignment="VerticalAlignment.Top"
                 VerticalGap="8"
                 Class="chat-message-list"
                 Style="@($"--chat-message-list-width:{Width};")">
        @foreach (var message in Messages ?? Enumerable.Empty<ChatMessageModel>())
        {
            var isUser = IsUserMessage(message);
            <FluentStack HorizontalAlignment="@(isUser ? HorizontalAlignment.End : HorizontalAlignment.Start)" Width="100%" Class="chat-message-item">
                <FluentCard Appearance="CardAppearance.Filled" Width="@(isUser ? "70%" : "100%")" Class="@(isUser ? "chat-message-card-user" : "chat-message-card-assistant")">
                    @if (isUser)
                    {
                        @message.Content
                    }
                    else
                    {
                        <FluentStack Orientation="Orientation.Vertical" Class="chat-markdown-content chat-markdown-container">
                            @((MarkupString)FormatAssistantMessage(message))
                        </FluentStack>
                    }
                </FluentCard>

            </FluentStack>
        }
    </FluentStack>
</div>


@code {
    private static readonly Regex SelectionToken = new(@"\[selection\|(?<kind>[^|\]]+)\|(?<id>[^|\]]+)\|(?<value>[^|\]]*)\|(?<label>[^\]]*)\]", RegexOptions.Compiled);

    [Parameter]
    public IEnumerable<ChatMessageModel> Messages { get; set; } = new List<ChatMessageModel>();

    [Parameter]
    public string Width { get; set; } = "100%";

    private static bool IsUserMessage(ChatMessageModel message) =>
        message?.Role?.ToLowerInvariant() == "user";

    private string FormatAssistantMessage(ChatMessageModel message)
        => ChatMessageFormatter.FormatAssistantMessageAsHtml(RemoveSelectionTokens(message.Content ?? string.Empty));

    private static string RemoveSelectionTokens(string message)
        => SelectionToken.Replace(message, string.Empty).Trim();
}
