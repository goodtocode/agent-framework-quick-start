@using Goodtocode.AgentFramework.Presentation.Web.Features.Chats.Models
@using Goodtocode.AgentFramework.Presentation.Web.Features.Chats.Services
@using Goodtocode.AgentFramework.Presentation.Web.Library.Skeleton

@inject IChatService chatService

@if (Sessions?.Any() == true)
{
    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Stretch" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Wrap="false">
        <FluentHorizontalScroll Style="width:80%;">
            @foreach (var session in SessionItems)
            {
                <FluentCard Width="220px" @onclick="() => SelectSession(session)" Style="@(GetSessionCardStyle(session))">
                    @if (editingSessionId == session.Id)
                    {
                        <ChatSessionEditForm Title="@session.Title"
                                             OnSave="(title) => EditSessionTitleAsync(session, title)"
                                             OnCancel="CancelEditing" />
                    }
                    else
                    {
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Style="min-width:0;">
                            <FluentText Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width:0; flex:1 1 auto;">
                                @session.Title
                            </FluentText>
                            @if (selectedSession?.Id == session.Id)
                            {
                                <FluentButton Appearance="ButtonAppearance.Subtle"
                                              IconStart="@(new Icons.Regular.Size20.MoreVertical())"
                                              OnClick="() => StartEditing(session)">
                                </FluentButton>
                            }
                        </FluentStack>
                    }
                </FluentCard>
            }
        </FluentHorizontalScroll>
    </FluentStack>
}
else
{
    <SkeletonList Timeout="3000" />
}

@code {
    [Parameter] public IEnumerable<ChatSessionModel>? Sessions { get; set; }
    [Parameter] public EventCallback<ChatSessionModel> OnSessionSelected { get; set; }
    [Parameter] public EventCallback<ChatSessionModel> OnRenameSession { get; set; }

    private Guid? editingSessionId;
    private EditSessionModel editModel = new();
    private EditContext? editContext;
    private ChatSessionModel? selectedSession;

    private IReadOnlyList<ChatSessionModel> SessionItems => Sessions?.ToList() ?? [];

    private async Task SelectSession(ChatSessionModel session)
    {
        selectedSession = session;
        await OnSessionSelected.InvokeAsync(session);
    }

    private void StartEditing(ChatSessionModel session)
    {
        editingSessionId = session.Id;
        editModel = new EditSessionModel { Title = session.Title };
        editContext = new EditContext(editModel);
    }

    private async Task EditSessionTitleAsync(ChatSessionModel session, string title)
    {
        session.Title = title;
        editingSessionId = null;
        await chatService.RenameSessionAsync(session.Id, title);
        await OnRenameSession.InvokeAsync(session);
    }

    private void CancelEditing() => editingSessionId = null;

    private string GetSessionCardStyle(ChatSessionModel session)
        => selectedSession?.Id == session.Id
            ? "border: 2px solid var(--accent-stroke-control-rest); min-width:160px;"
            : "min-width:160px;";

    public void ClearSelection()
    {
        selectedSession = null;
        StateHasChanged();
    }

    public class EditSessionModel
    {
        [Required(ErrorMessage = "Title is required.")]
        public string? Title { get; set; }
    }
}