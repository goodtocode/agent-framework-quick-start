@using Goodtocode.AgentFramework.Presentation.Web.Features.Chats.Models

@if (Actions.Count > 0)
{
    <FluentStack Orientation="Orientation.Horizontal"
                 HorizontalAlignment="HorizontalAlignment.Center"
                 Wrap="true"
                 Class="chat-action-strip">
        @foreach (var action in Actions)
        {
            <FluentButton Appearance="ButtonAppearance.Subtle"
                          OnClick="() => OnActionClicked.InvokeAsync(action)">
                @action.Label
            </FluentButton>
        }
    </FluentStack>
}

@code {
    [Parameter] public IReadOnlyList<ChatSelectionOption> Actions { get; set; } = [];
    [Parameter] public EventCallback<ChatSelectionOption> OnActionClicked { get; set; }
}