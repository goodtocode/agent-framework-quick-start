@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

<EditForm FormName="ChatSessionEdit" EditContext="editContext" OnValidSubmit="HandleValidSubmit">
    <FluentGrid Spacing="0" Justify="JustifyContent.FlexStart">
        <FluentGridItem xs="10">
            <FluentTextInput Value="@editModel.Title"
                             ValueChanged="OnTitleChanged"
                             Width="100%"
                             Label=""
                             Required="true"
                             Autofocus="true" />
        </FluentGridItem>
        <FluentGridItem xs="1">
            <FluentButton Type="ButtonType.Submit"
                          Appearance="ButtonAppearance.Subtle"
                          Size="ButtonSize.Medium"
                          IconOnly="true"
                          Disabled="@isSubmitting"
                          IconStart="new Icons.Regular.Size20.Save()"
                          Title="Save title"
                          AriaLabel="Save title"></FluentButton>
        </FluentGridItem>
        <FluentGridItem xs="1">
            <FluentButton Type="ButtonType.Button"
                          Appearance="ButtonAppearance.Subtle"
                          Size="ButtonSize.Medium"
                          IconOnly="true"
                          IconStart="new Icons.Regular.Size20.Dismiss()"
                          Title="Cancel edit"
                          AriaLabel="Cancel edit"
                          OnClick="() => OnCancel.InvokeAsync(null)"></FluentButton>
        </FluentGridItem>
    </FluentGrid>
    <ValidationSummary />
</EditForm>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public EventCallback<string> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private EditSessionModel editModel = new();
    private EditContext? editContext;
    private bool isSubmitting;

    protected override void OnParametersSet()
    {
        editModel = new EditSessionModel { Title = Title };
        editContext = new EditContext(editModel);
    }

    private void OnTitleChanged(string value)
    {
        editModel.Title = value;
    }

    private async Task HandleValidSubmit()
    {
        if (isSubmitting)
            return;

        if (editContext is null || !editContext.Validate())
            return;

        isSubmitting = true;
        try
        {
            await OnSave.InvokeAsync(editModel.Title!);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class EditSessionModel
    {
        [Required(ErrorMessage = "Title is required.")]
        public string? Title { get; set; }
    }
}