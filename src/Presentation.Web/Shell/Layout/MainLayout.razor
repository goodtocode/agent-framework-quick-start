@using Goodtocode.AgentFramework.Presentation.Web.Library
@using Goodtocode.AgentFramework.Presentation.Web.Library.Analytics
@using Goodtocode.AgentFramework.Presentation.Web.Library.Auth.Components
@using Goodtocode.AgentFramework.Presentation.Web.Library.Auth.Routing
@using Goodtocode.AgentFramework.Presentation.Web.Library.Auth.Services
@using Goodtocode.AgentFramework.Presentation.Web.Library.HorizontalMenu
@using Goodtocode.AgentFramework.Presentation.Web.Library.HorizontalMenu.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Identity.Web

@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IUserSyncService UserSyncService
@inject ILogger<MainLayout> Logger

<FluentLayout Height="100dvh">
  <FluentLayoutItem Area="@LayoutArea.Header" Sticky="true" Padding="@Padding.All2">
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
      <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
        <FluentLayoutHamburger />
                <FluentAnchorButton Href="/"
                            Appearance="ButtonAppearance.Primary"
                            Shape="ButtonShape.Rounded"
                            Size="ButtonSize.Small"
                            Title="Go to home page">
            <img src="img/logo.png" alt="GoodToCode" height="40" />
        </FluentAnchorButton>
        <FluentAnchorButton Href="/"
                            Appearance="ButtonAppearance.Transparent"
                            Size="ButtonSize.Large"
                            Title="Go to home page">
          Quick-start for Microsoft Agent Framework
        </FluentAnchorButton>
      </FluentStack>
      <UserProfile />
    </FluentStack>
  </FluentLayoutItem>

  <FluentLayoutItem Area="@LayoutArea.Navigation" Width="260px">
    <FluentNav Padding="@Padding.All2">
      <FluentNavItem Href="/" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.Home())">
        Home
      </FluentNavItem>
      <FluentNavItem Href="/chat" IconRest="@(new Icons.Regular.Size20.Chat())">
        Chat Session
      </FluentNavItem>
    </FluentNav>
  </FluentLayoutItem>

  <FluentLayoutItem Area="@LayoutArea.Content" Padding="@Padding.All3">
    <ErrorBoundary @ref="errorBoundaryRef">
      <ChildContent>
        @if (ActivePlatformNavigation is not null)
        {
          <WorkspaceNavigation Model="ActivePlatformNavigation" />
          <VerticalSpacer />
        }
        @Body
        <FluentMenuProvider />
        <FluentDialogProvider />
      </ChildContent>
      <ErrorContent Context="ex">
        <FluentDialog Modal="true">
          <FluentCard>
            <H3Label>
              Oops! Something went wrong.
            </H3Label>
            <PLabel>
              @ex.Message
            </PLabel>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
              <FluentButton OnClick="@(() => OnRecoverAndNavigate(ex))">
                Go Home
              </FluentButton>
            </FluentStack>
          </FluentCard>
        </FluentDialog>
      </ErrorContent>
    </ErrorBoundary>
  </FluentLayoutItem>

  <FluentLayoutItem Area="@LayoutArea.Footer" Sticky="true" Padding="@Padding.All2">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="6" HorizontalAlignment="HorizontalAlignment.Center">
      <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true" HorizontalAlignment="HorizontalAlignment.Center">
        <FluentLink Href="/privacy">Privacy Policy</FluentLink>
        <FluentLink Href="/terms">Terms of Use</FluentLink>
        <FluentLink Href="/analytics-notice">Analytics Notice</FluentLink>
      </FluentStack>
      <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
        © @DateTime.Now.Year Goodtocode
      </FluentStack>
    </FluentStack>
  </FluentLayoutItem>
</FluentLayout>

<AnalyticsConsentBanner />

@code {
  private ErrorBoundary? errorBoundaryRef;

  private void OnRecoverAndNavigate(Exception ex)
  {
    errorBoundaryRef?.Recover();
    Navigation.NavigateTo("/", forceLoad: true);
  }

  private bool _synced = false;

  private PlatformNavigationModel? ActivePlatformNavigation
  {
    get
    {
      var route = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
      if (string.IsNullOrWhiteSpace(route))
      {
        return null;
      }

      var segment = route.Split('/', StringSplitOptions.RemoveEmptyEntries)[0];
      return PlatformNavigationModel.All.FirstOrDefault(m =>
          m.Prefix.Equals(segment, StringComparison.OrdinalIgnoreCase));
    }
  }

  protected override async Task OnInitializedAsync()
  {
    try
    {
      if (_synced)
        return;

      var authState = await AuthStateProvider.GetAuthenticationStateAsync();
      var user = authState.User;

      if (user.Identity?.IsAuthenticated == true)
      {
        await UserSyncService.SyncUserAsync(user);
        _synced = true;
      }
    }
    catch (MicrosoftIdentityWebChallengeUserException)
    {
      Navigation.NavigateTo(RouteConstants.SignIn, forceLoad: true);
    }
    catch (Exception ex) when (IsTransientUserSyncStartupFailure(ex))
    {
      Logger.LogWarning(ex, "Initial user sync failed during startup; continuing and allowing retry on subsequent requests.");
    }
  }

  private static bool IsTransientUserSyncStartupFailure(Exception ex)
  {
    return EnumerateExceptions(ex).Any(e =>
        e is TaskCanceledException
        || e is OperationCanceledException
        || e is HttpRequestException
        || e is IOException
        || string.Equals(e.GetType().Name, "TimeoutRejectedException", StringComparison.Ordinal));
  }

  private static IEnumerable<Exception> EnumerateExceptions(Exception ex)
  {
    for (Exception? current = ex; current is not null; current = current.InnerException)
    {
      yield return current;
    }
  }
}
